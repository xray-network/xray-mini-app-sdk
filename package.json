{
  "name": "xray-mini-app-sdk-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "clean": "yarn workspaces run clean",
    "lint": "echo \"No lint configured\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json,css,scss,html}\"",
    "publish:sdk": "yarn workspace xray-mini-app-sdk publish --access public",
    "publish:sdk-cip30": "yarn workspace xray-mini-app-sdk-cip30 publish --access public"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "serve": "^14.2.5",
    "typescript": "^5.4.0"
  }
}
